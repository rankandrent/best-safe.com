---
import { SITE } from '../lib/site';
interface Props { href?: string; label?: string }
const { href = '/', label = `${SITE.name} home` } = Astro.props;
---
<a href={href} class="logo" aria-label={label}>
  <svg viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="8" fill="#1f1c1a"/><rect x="7.5" y="6.5" width="25" height="24" rx="2.6" fill="#f5f2ec"/><rect x="10.5" y="9.5" width="19" height="18" rx="1.4" fill="none" stroke="#1f1c1a" stroke-width="1.4"/><circle cx="18" cy="18.5" r="4.6" fill="none" stroke="#1f1c1a" stroke-width="2"/><circle cx="18" cy="18.5" r="1.3" fill="#1f1c1a"/><path d="M18 12.4v1.6M18 23v1.6M11.9 18.5h1.6M22.5 18.5h1.6" stroke="#1f1c1a" stroke-width="1.4"/><path d="M26.2 15.5v6" stroke="#f97316" stroke-width="2.8" stroke-linecap="round"/><rect x="10" y="30.5" width="5" height="3" rx=".6" fill="#f5f2ec"/><rect x="25" y="30.5" width="5" height="3" rx=".6" fill="#f5f2ec"/>
  </svg>
  <span>Best<b class="logo-accent">Safe</b></span>
</a>
