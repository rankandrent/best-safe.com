---
import Base from '../layouts/Base.astro';
import PostItem from '../components/PostItem.astro';
import Icon from '../components/Icon.astro';
import { getPublishedPosts } from '../lib/posts';
import { SITE, CATEGORY_ICON, absUrl } from '../lib/site';

const posts = await getPublishedPosts();
const [leadPost, ...rest] = posts;
// Older guides we re-checked and actually changed recently (real updates only).
const recentlyUpdated = posts
  .filter((p) => p.data.updatedDate && p.data.updatedDate.getTime() > Date.now() - 30 * 86400000)
  .sort((a, b) => b.data.updatedDate!.getTime() - a.data.updatedDate!.getTime())
  .slice(0, 5);
const counts = Object.fromEntries(SITE.categories.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]));

const jsonLd: object[] = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Latest guides',
  itemListElement: posts.slice(0, 10).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: absUrl(`/blog/${p.id}/`), name: p.data.title })),
}];
---
<Base title={`${SITE.name} – Honest Safe Buying Guides`} description={SITE.description} jsonLd={jsonLd} image="/images/og/home.png" imageAlt={`${SITE.name}: honest safe buying guides`} keywords={['best safe', 'safe buying guide', 'best gun safe', 'best fireproof safe', 'best-safe.com']}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>The right safe for what you need to protect.</h1>
        <p class="lead">We research handgun safes, gun safes, fireproof document safes, home safes and lock boxes on the specs that matter: the lock and its backup, the steel, who certified the fire rating, how fast you can get in, and whether it bolts down. Research-based, never pay-to-play.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog/">Browse the guides</a>
          <a class="btn btn-quiet" href="/safe-buying-checklist/">Get the buying checklist</a>
          <a class="btn btn-quiet" href="/how-we-score/">How we score</a>
        </div>
      </div>

      <figure class="specsheet" aria-label="A safe spec sheet, annotated with what the claims really mean">
        <div class="doc"><span>Spec sheet</span><span>Home safe, digital lock</span></div>
        <h2>What the box says vs. what you get</h2>
        <p>"Fireproof": <s>forever</s>. Fire-resistant for a rated time and temperature; check who certified it.</p>
        <p>"Heavy-duty steel": <s>a spec</s>. Ask for the gauge: a lower number means thicker steel.</p>
        <p>"Secure": <s>on its own</s>. A small safe that isn't bolted down can leave with the burglar.</p>
        <div class="notes">
          <span class="tape">Fire rating</span>
          <span class="tape alt">Steel gauge</span>
          <span class="tape">Bolt it down</span>
        </div>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Find a safe by type</h2>
          <p>Every category is judged on the same five things: security, fire protection, access, capacity and value.</p>
        </div>
      </div>
      <div class="rooms">
        {SITE.categories.map((c) => (
          <a class="room" href={`/category/${c.slug}/`}>
            <Icon name={CATEGORY_ICON[c.slug] ?? 'safe'} />
            <span><strong>{c.name}</strong><span class="blurb">{c.blurb}</span></span>
            <span class="count">{counts[c.slug] ? `${counts[c.slug]} guide${counts[c.slug] === 1 ? '' : 's'}` : 'Coming soon'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><h2>Latest guides</h2></div>
        <a class="btn btn-quiet btn-sm" href="/blog/">See all guides</a>
      </div>
      {leadPost ? (
        <div class="posts">
          <PostItem post={leadPost} lead />
          {rest.slice(0, 9).map((p) => <PostItem post={p} />)}
        </div>
      ) : <p class="empty">Our first guides are being researched now. In the meantime, start with the <a href="/safe-buying-checklist/">safe buying checklist</a>.</p>}
    </div>
  </section>

  {recentlyUpdated.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div><h2>Recently re-checked</h2><p class="muted">Guides we re-verified against their sources and updated.</p></div>
        </div>
        <ul class="updated-list">
          {recentlyUpdated.map((p) => (
            <li>
              <a href={`/blog/${p.id}/`}>{p.data.title}</a>
              <span class="muted">Updated <time datetime={p.data.updatedDate!.toISOString()}>{p.data.updatedDate!.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Our three rules</h2>
          <p>Every product on this site passes these before we recommend it. <a href="/how-we-research/">Read the full research process</a>.</p>
        </div>
      </div>
      <div class="clauses">
        <div class="clause"><h3>Real ratings, not box claims</h3><p>We separate independent fire and burglary ratings from a maker's own claims, and report steel gauge, bolt work and lock type instead of marketing words.</p></div>
        <div class="clause"><h3>Matched to what you store</h3><p>A handgun by the bed, long guns, passports and deeds, cash and jewelry, or a pistol in the truck: we say who each pick is for, and who should skip it.</p></div>
        <div class="clause"><h3>Honest about trade-offs</h3><p>We say when a fire claim isn't certified, when a fingerprint reader frustrates owners, when you need to buy bolts separately, and where a cheaper safe does the job.</p></div>
      </div>
    </div>
  </section>
</Base>
